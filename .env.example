# Public canonical origin used in transactional emails. HTTPS is required outside local development.
APP_URL=https://woodenbridge.vercel.app

# Optional Google Search Console HTML-tag verification value.
GOOGLE_SITE_VERIFICATION=

# Auth.js encryption/signing secret.
AUTH_SECRET=

# Independent HMAC keys for auth pseudonyms/codes and signed private-media
# grants. Use separate random values of at least 32 bytes in production.
AUTH_HMAC_SECRET=
MEDIA_GRANT_SECRET=

# Stable cross-instance Server Action encryption key.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Pooled, least-privilege application connection. The runtime role must not own
# the schema or have CREATE, TRUNCATE, CREATEDB, CREATEROLE, or BYPASSRLS.
DATABASE_URL=

# Direct/unpooled schema-owner connection used only by `npm run migrate` and
# operator scripts. Do not expose this credential to the deployed application.
MIGRATION_DATABASE_URL=

# High-entropy bearer secret used by Vercel Cron for internal maintenance.
CRON_SECRET=

# WebAuthn relying-party configuration. The origin must be HTTPS outside local
# development, and the RP ID must equal its hostname or a parent domain.
PASSKEY_ORIGIN=https://woodenbridge.vercel.app
PASSKEY_RP_ID=woodenbridge.vercel.app

# Production transactional email delivery through Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Field Atlas <account@prill.io>
RESEND_REPLY_TO_EMAIL=

# Local development only. Never enable console email delivery in production.
EMAIL_DELIVERY=console

# Optional: replace the no-key OpenFreeMap default with a compatible MapLibre style URL.
NEXT_PUBLIC_ATLAS_STYLE_URL=

# Optional Nominatim-compatible reverse-geocoder endpoint and identifying user agent.
ATLAS_GEOCODER_ENDPOINT=https://nominatim.openstreetmap.org/reverse
ATLAS_GEOCODER_USER_AGENT=FieldAtlas/1.0 (https://woodenbridge.vercel.app; place-enrichment)

# Private Vercel Blob store for atlas photos. Never expose the read-write token to the browser.
ATLAS_BLOB_STORE_ID=
ATLAS_BLOB_READ_WRITE_TOKEN=
