# Public canonical origin used to build reset links. HTTPS is required outside local development.
APP_URL=https://your-domain.example

# Auth.js encryption/signing secret.
AUTH_SECRET=

# Neon/Vercel Postgres connection.
DATABASE_URL=

# Production password-reset email delivery through Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Wooden Bridge <account@your-domain.example>

# Local development only. Never enable console token delivery in production.
PASSWORD_RESET_DELIVERY=console
